# Copy to .env (never commit it).

# --translator claude-code: uses your Claude Pro/Max subscription. Create a token with
# `claude setup-token` on your machine and paste it here.
# CLAUDE_CODE_OAUTH_TOKEN=
# WATCHALONG_CLAUDE_MODEL=        # optional, e.g. sonnet or opus (default: the CLI's default)

# Placeholders, not implemented yet:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
